# Copy to .env.local and fill in. Never commit real values.
#   cp .env.example .env.local

# PostgreSQL connection string.
#   Local Postgres:  postgresql://<user>@localhost:5432/brain9_dev?schema=public
#   Docker compose:  postgresql://brain9:brain9@localhost:5433/brain9_dev?schema=public
#   Neon dev branch: the POOLED connection string of your own dev/<name> branch
DATABASE_URL=""

# Optional. Non-pooled connection string used only by `prisma migrate` (recommended on Neon).
# DIRECT_URL=""

# local | staging | production. Leave as "local" on your machine.
APP_ENV="local"

# LOCAL ONLY: sign in automatically as the seeded demo ADMIN or USER until the real login
# is built. Ignored on staging/production. Remove the line to test signed-out behaviour.
DEV_AUTH_ROLE="ADMIN"
